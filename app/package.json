{
  "name": "app",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify-migrations && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node scripts/run-dev.mjs",
    "tauri:build": "tauri build",
    "tauri:build:windows": "node scripts/run-dev.mjs --build",
    "tauri:build:mac": "tauri build --bundles app,dmg",
    "verify-migrations": "node scripts/verify-migrations.mjs",
    "macos:preflight": "node scripts/macos-preflight.mjs",
    "macos:build": "node scripts/macos-build.mjs",
    "pages:dev": "wrangler pages dev dist --d1 DB=dra-ana-estoque-db",
    "d1:prepare": "python scripts/prepare_d1_schema.py && python scripts/export_d1_data.py",
    "d1:init:local": "wrangler d1 execute dra-ana-estoque-db --local --file=./scripts/d1-schema.sql && wrangler d1 execute dra-ana-estoque-db --local --file=./scripts/d1-seed-data.sql",
    "d1:init:remote": "wrangler d1 execute dra-ana-estoque-db --remote --file=./scripts/d1-schema.sql && wrangler d1 execute dra-ana-estoque-db --remote --file=./scripts/d1-seed-data.sql",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name=dra-ana-estoque",
    "audit": "node scripts/system-audit-suite.mjs",
    "test:audit": "node scripts/system-audit-suite.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/jszip": "^3.4.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@zxing/browser": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx-preview": "^0.4.1",
    "hono": "^4.13.13",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.17.0",
    "node-forge": "^1.4.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.78.0",
    "react-select": "^5.10.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.2",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "wrangler": "^4.150.0"
  }
}
